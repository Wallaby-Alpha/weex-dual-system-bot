# ==========================================
# WEEX DUAL-SYSTEM BOT CONFIGURATION
# ==========================================

# Trading Mode: Set to False for real live execution with real money
DRY_RUN=True

# WEEX V3 Contract API Credentials (create in WEEX Account -> API Management)
WEEX_API_KEY=your_weex_api_key_here
WEEX_API_SECRET=your_weex_api_secret_here
WEEX_PASSPHRASE=your_weex_passphrase_here
WEEX_BASE_URL=https://api-contract.weex.com

# Risk Management: Fixed Risk per Trade
DOLLAR_RISK=1.00
MAX_OPEN_POSITIONS=3
DEFAULT_LEVERAGE=10

# Telegram Bot Alert Settings
# 1. Create a bot via @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Get your Chat ID by messaging @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Market Scanner Settings
TOP_N_UNIVERSE=60
SCAN_INTERVAL_SEC=30
MIN_PUMP_GAIN_PCT=8.0
MIN_VOL_SPIKE=3.5
MIN_QUOTE_VOL=30000.0

# Strategy Toggles
SYS1_ENABLED=True
SYS2_ENABLED=True
LOG_LEVEL=INFO
